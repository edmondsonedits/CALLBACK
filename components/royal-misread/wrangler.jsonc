{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "callback-royal-misread-prototype",
  "main": "src/index.js",
  "compatibility_date": "2026-09-09",
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
